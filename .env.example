# QuStox — Environment Variables
# Copy this file to .env and fill in your keys.
#   cp .env.example .env
#
# ⚠️  Never commit .env to git — it is listed in .gitignore.

# ── Required for sentiment agent (run.py + infer_pipeline.py) ────────────────
OPENAI_API_KEY=sk-...

# ── Optional overrides ────────────────────────────────────────────────────────
# Model used for regime classification (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Model used for historical headline recall (default: gpt-4o)
# OPENAI_RECALL_MODEL=gpt-4o

# ── Required for xpyq cloud execution (infer_xpyq.py) ────────────────────────
# XPYQ_API_KEY=xpyq_live_...

# ── Required for real IBM QPU via xpyq (--mode qpu) ──────────────────────────
# IBM_QUANTUM_TOKEN=YOUR_IBM_QUANTUM_TOKEN_HERE
